<!doctype html><html lang="en"><head>#includeTemplate($model.weblog "standard_head")<title>Search — $model.weblog.name</title></head><body>#includeTemplate($model.weblog "standard_header")<main id="content" class="reading-shell"><header class="page-title"><p class="kicker">Search the trail</p><h1>“$model.term”</h1><p>$model.hits results</p></header><form class="big-search" method="get" action="$url.search"><input name="q" type="search" value="$model.term" aria-label="Search"><button>Search</button></form>#if($model.hits>0)#set($pager=$model.getWeblogEntriesPager())#showWeblogEntriesPager($pager)<nav class="pager">#showNextPrevEntriesControl($pager)</nav>#else<p>No stories found. Try another trail.</p>#end</main>#includeTemplate($model.weblog "standard_footer")</body></html>
