## Minima's home post list, shared by the weblog, tag, and search templates.
## Expects $pager to be set by the including template.
#set($listEntries = [])
#foreach($day in $pager.entries.keySet())
  #foreach($entry in $pager.entries.get($day))
    #set($added = $listEntries.add($entry))
  #end
#end
#if($listEntries.size() > 0)
<ul class="post-list">
  #foreach($entry in $listEntries)
  <li>
    <span class="post-meta">$utils.formatDate($entry.pubTime, "MMM d, yyyy")</span>
    <h3>
      <a class="post-link" href="$url.entry($entry.anchor)">$entry.title</a>
    </h3>
    #if($utils.isNotEmpty($entry.summary))
    <div class="post-excerpt">$entry.transformedSummary</div>
    #elseif($model.searchResults)
    <p class="post-excerpt">$utils.truncateNicely($utils.removeHTML($entry.transformedText), 160, 200, "&hellip;")</p>
    #end
  </li>
  #end
</ul>
#else
<p class="post-list-empty">No posts here yet.</p>
#end
#if($pager.prevLink || $pager.nextLink)
<div class="pager">
  <ul class="pagination">
    #if($pager.prevLink)
    <li><a href="$pager.prevLink" class="previous-page" title="Newer posts">&laquo; Newer</a></li>
    #else
    <li><div class="pager-edge">&bull;</div></li>
    #end
    #if($model.searchResults)
      #set($pageNumber = $model.offset / $model.limit + 1)
    #else
      #set($pageParam = $model.getRequestParameter("page"))
      #if($pageParam && $pageParam.matches("[0-9]+"))
        #set($pageNumber = $listEntries.size().parseInt($pageParam) + 1)
      #else
        #set($pageNumber = 1)
      #end
    #end
    <li><div class="current-page">$pageNumber</div></li>
    #if($pager.nextLink)
    <li><a href="$pager.nextLink" class="next-page" title="Older posts">Older &raquo;</a></li>
    #else
    <li><div class="pager-edge">&bull;</div></li>
    #end
  </ul>
</div>
#end
