<header class="site-header">
  <div class="wrapper">
    <a class="site-title" rel="author" href="$url.home">$model.weblog.name</a>
    #set($navPages = [])
    #foreach($navPage in $model.weblog.templates)
      #if($navPage.navbar && !$navPage.hidden && $navPage.link)
        #set($added = $navPages.add($navPage))
      #end
    #end
    #if($navPages.size() > 0)
    <nav class="site-nav" aria-label="Pages">
      <input type="checkbox" id="nav-trigger">
      <label for="nav-trigger" aria-label="Menu">
        <span class="menu-icon">
          <svg class="icon-open" viewBox="0 0 18 15" width="18" height="15" aria-hidden="true">
            <path d="M18,1.484c0,0.82-0.665,1.484-1.484,1.484H1.484C0.665,2.969,0,2.304,0,1.484l0,0C0,0.665,0.665,0,1.484,0h15.032C17.335,0,18,0.665,18,1.484L18,1.484z M18,7.516C18,8.335,17.335,9,16.516,9H1.484C0.665,9,0,8.335,0,7.516l0,0c0-0.82,0.665-1.484,1.484-1.484h15.032C17.335,6.031,18,6.696,18,7.516L18,7.516z M18,13.516C18,14.335,17.335,15,16.516,15H1.484C0.665,15,0,14.335,0,13.516l0,0c0-0.82,0.665-1.483,1.484-1.483h15.032C17.335,12.031,18,12.695,18,13.516L18,13.516z"/>
          </svg>
          <svg class="icon-close" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
            <path d="M2.1,0.5L8,6.4l5.9-5.9c0.4-0.4,1.1-0.4,1.6,0c0.4,0.4,0.4,1.1,0,1.6L9.6,8l5.9,5.9c0.4,0.4,0.4,1.1,0,1.6c-0.4,0.4-1.1,0.4-1.6,0L8,9.6l-5.9,5.9c-0.4,0.4-1.1,0.4-1.6,0c-0.4-0.4-0.4-1.1,0-1.6L6.4,8L0.5,2.1c-0.4-0.4-0.4-1.1,0-1.6C0.9,0.1,1.6,0.1,2.1,0.5z"/>
          </svg>
        </span>
      </label>
      <div class="nav-items">
        #foreach($navPage in $navPages)
        <a class="nav-item#if($model.weblogPage && $model.weblogPage.id == $navPage.id) active#end" href="$url.page($navPage.link)">$navPage.name</a>
        #end
      </div>
    </nav>
    #end
  </div>
</header>
