<!DOCTYPE html>
<html lang="$model.weblog.localeInstance.toLanguageTag()">
  <head>
    #includeTemplate($model.weblog "standard_head")
    <title>Archives | $model.weblog.name</title>
  </head>
  <body>
    #includeTemplate($model.weblog "standard_header")
    <main class="page-content" aria-label="Content">
      <div class="wrapper">
        <article class="post archives">
          <header class="post-header">
            <h1 class="post-title">Archives</h1>
            <div class="post-meta">$model.weblog.entryCount #if($model.weblog.entryCount == 1)post#{else}posts#end</div>
          </header>

          <div class="post-content">
            #set($archiveEntries = $model.weblog.getRecentWeblogEntries("nil", 100))
            #set($currentYear = "")
            #foreach($archiveEntry in $archiveEntries)
              #set($entryYear = $utils.formatDate($archiveEntry.pubTime, "yyyy"))
              #if($entryYear != $currentYear)
                #if($currentYear != "")
            </ul>
                #end
                #set($currentYear = $entryYear)
            <h2 class="archive-year">$entryYear</h2>
            <ul class="post-list archive-list">
              #end
              <li>
                <span class="post-meta">$utils.formatDate($archiveEntry.pubTime, "MMM d")</span>
                <a class="post-link" href="$url.entry($archiveEntry.anchor)">$archiveEntry.title</a>
              </li>
            #end
            #if($currentYear != "")
            </ul>
            #end

            #set($archiveCategories = $model.weblog.weblogCategories)
            #if($archiveCategories.size() > 0)
            <h2>Categories</h2>
            <ul class="archive-terms">
              #foreach($archiveCategory in $archiveCategories)
              <li><a href="$url.category($archiveCategory.name)">$archiveCategory.name</a></li>
              #end
            </ul>
            #end

            #set($archiveTags = $model.weblog.getPopularTags(-1, 50))
            #if($archiveTags.size() > 0)
            <h2>Tags</h2>
            <ul class="archive-terms">
              #foreach($archiveTag in $archiveTags)
              <li><a href="$url.tag($archiveTag.name)">$archiveTag.name</a> <span class="post-meta">($archiveTag.count)</span></li>
              #end
            </ul>
            #end
          </div>
        </article>
      </div>
    </main>
    #includeTemplate($model.weblog "standard_footer")
  </body>
</html>
