<footer class="site-footer h-card">
  <data class="u-url" value="$url.home"></data>
  <div class="wrapper">
    <h2 class="footer-heading">$model.weblog.name</h2>
    <div class="footer-col-wrapper">
      <div class="footer-col">
        <ul class="contact-list">
          #if($utils.isNotEmpty($model.weblog.creator.fullName))
          <li class="p-name">$model.weblog.creator.fullName</li>
          #else
          <li class="p-name">$model.weblog.creator.screenName</li>
          #end
        </ul>
      </div>
      #if($utils.isNotEmpty($model.weblog.tagline))
      <div class="footer-col">
        <p>$model.weblog.tagline</p>
      </div>
      #end
    </div>
    <div class="social-links">
      <ul class="social-media-list">
        <li>
          <a href="$url.feed.entries.atom" title="Subscribe to syndication feed">
            <svg class="svg-icon grey" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M12.8 16C12.8 8.978 7.022 3.2 0 3.2V0c8.777 0 16 7.223 16 16h-3.2zM2.194 11.61c1.21 0 2.195.985 2.195 2.196 0 1.21-.99 2.194-2.2 2.194C.98 16 0 15.017 0 13.806c0-1.21.983-2.195 2.194-2.195zM10.606 16h-3.11c0-4.113-3.383-7.497-7.496-7.497v-3.11c5.818 0 10.606 4.79 10.606 10.607z"/>
            </svg>
            <span class="sr-only">Atom feed</span>
          </a>
        </li>
      </ul>
      <form class="footer-search" method="get" action="$url.search" role="search">
        <label class="sr-only" for="footer-search-q">Search $model.weblog.name</label>
        <input id="footer-search-q" name="q" type="search" placeholder="Search" value="#if($model.searchResults)$model.term#end">
      </form>
    </div>
  </div>
</footer>
