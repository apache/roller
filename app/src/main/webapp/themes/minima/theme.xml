  <template action="custom"><name>standard_footer</name><description>Site footer</description><navbar>false</navbar><hidden>true</hidden><contentType>text/html</contentType><rendition><contentsFile>footer.vm</contentsFile><templateLanguage>velocity</templateLanguage></rendition></template>
