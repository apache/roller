  <preview-image path="preview.png" />
  <stylesheet><name>custom.css</name><description>Minima custom styles</description><link>custom.css</link><contentType>text/css</contentType><rendition><contentsFile>custom.css</contentsFile><templateLanguage>velocity</templateLanguage></rendition></stylesheet>
  <template action="weblog"><name>Weblog</name><description>Home, category, and date archive lists</description><navbar>false</navbar><hidden>true</hidden><contentType>text/html</contentType><rendition><contentsFile>weblog.vm</contentsFile><templateLanguage>velocity</templateLanguage></rendition></template>
