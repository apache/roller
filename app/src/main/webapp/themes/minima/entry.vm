<!DOCTYPE html>
<html lang="$model.weblog.localeInstance.toLanguageTag()">
  <head>
    #includeTemplate($model.weblog "standard_head")
    <title>$model.weblogEntry.title | $model.weblog.name</title>
  </head>
  <body>
    #includeTemplate($model.weblog "standard_header")
    <main class="page-content" aria-label="Content">
      <div class="wrapper">
        #set($entry = $model.weblogEntry)
        <article class="post h-entry">
          <header class="post-header">
            <h1 class="post-title p-name">$entry.title</h1>
            <div class="post-meta">
              <time class="dt-published" datetime="$utils.formatIso8601Date($entry.pubTime)">$utils.formatDate($entry.pubTime, "MMM d, yyyy")</time>
              #set($authorName = $entry.creator.fullName)
              #if($utils.isEmpty($authorName))#set($authorName = $entry.creator.screenName)#end
              #if($utils.isNotEmpty($authorName))
              <div class="force-inline post-authors">
                <span class="p-author h-card">$authorName</span>
              </div>
              #end
            </div>
          </header>

          <div class="post-content e-content">
            $entry.displayContent
          </div>

          <footer class="post-footer">
            #if($entry.category)
            <span class="post-category">Posted in <a href="$url.category($entry.category.name)">$entry.category.name</a></span>
            #end
            #if($entry.tags && $entry.tags.size() > 0)
            <span class="post-tags">
              #foreach($tag in $entry.tags)
              <a href="$url.tag($tag.name)" rel="tag">$tag.name</a>
              #end
            </span>
            #end
            #if($utils.isUserAuthorizedToAuthor($entry.website))
            <a class="post-edit" href="$url.editEntry($entry.anchor)">Edit</a>
            #end
          </footer>

          #set($pager = $model.getWeblogEntriesPager())
          #if($pager.prevLink || $pager.nextLink)
          <nav class="pager" aria-label="More posts">
            <ul class="pagination">
              #if($pager.prevLink)
              <li><a href="$pager.prevLink" class="previous-page" title="Older post">&laquo; $pager.prevName</a></li>
              #else
              <li><div class="pager-edge">&bull;</div></li>
              #end
              <li><a href="$url.home" class="current-page" title="All posts">All posts</a></li>
              #if($pager.nextLink)
              <li><a href="$pager.nextLink" class="next-page" title="Newer post">$pager.nextName &raquo;</a></li>
              #else
              <li><div class="pager-edge">&bull;</div></li>
              #end
            </ul>
          </nav>
          #end

          <section class="post-comments">
            #showWeblogEntryComments($entry)
            #showWeblogEntryCommentForm($entry)
          </section>
        </article>
      </div>
    </main>
    #includeTemplate($model.weblog "standard_footer")
  </body>
</html>
