<!DOCTYPE html>
<html lang="$model.weblog.localeInstance.toLanguageTag()">
  <head>
    #includeTemplate($model.weblog "standard_head")
    #if($model.tags && $model.tags.size() > 0)
    <title>#foreach($tagName in $model.tags)$tagName#if($foreach.hasNext), #end#end | $model.weblog.name</title>
    #elseif($model.weblogCategory)
    <title>$model.weblogCategory.name | $model.weblog.name</title>
    #elseif($utils.isNotEmpty($model.weblog.tagline))
    <title>$model.weblog.name | $model.weblog.tagline</title>
    #else
    <title>$model.weblog.name</title>
    #end
  </head>
  <body>
    #includeTemplate($model.weblog "standard_header")
    <main class="page-content" aria-label="Content">
      <div class="wrapper">
        <div class="home">
          #set($pager = $model.getWeblogEntriesPager())
          #if($model.tags && $model.tags.size() > 0)
          <h1 class="page-heading">Tagged #foreach($tagName in $model.tags)<span class="tag-name">$tagName</span>#if($foreach.hasNext), #end#end</h1>
          #elseif($model.weblogCategory)
          <h1 class="page-heading">$model.weblogCategory.name</h1>
          #if($utils.isNotEmpty($model.weblogCategory.description))
          <p class="page-description">$model.weblogCategory.description</p>
          #end
          #elseif(!$pager.prevLink && $utils.isNotEmpty($model.weblog.about))
          <div class="home-about">$model.weblog.about</div>
          #end
          <h2 class="post-list-heading">Posts</h2>
          #includeTemplate($model.weblog "_post_list")
          #if($model.tags && $model.tags.size() > 0)
          <p class="rss-subscribe">subscribe <a href="$url.feed.entries.atomByTags($model.tags, false)">via Atom</a></p>
          #elseif($model.weblogCategory)
          <p class="rss-subscribe">subscribe <a href="$url.feed.entries.atom($model.weblogCategory.name, false)">via Atom</a></p>
          #else
          <p class="rss-subscribe">subscribe <a href="$url.feed.entries.atom">via Atom</a></p>
          #end
        </div>
      </div>
    </main>
    #includeTemplate($model.weblog "standard_footer")
  </body>
</html>
