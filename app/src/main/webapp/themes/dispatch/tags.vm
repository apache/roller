<!doctype html>
<html lang="en">
  <head>
    #includeTemplate($model.weblog "standard_head")
    <title>#foreach($tagName in $model.tags)$tagName#if($foreach.hasNext), #end#end / $model.weblog.name</title>
  </head>
  <body>
    #includeTemplate($model.weblog "standard_header")
    <main id="content" class="reading-shell">
      <header class="page-title">
        <p class="label">FILTER / TAG</p>
        <h1>#foreach($tagName in $model.tags)$tagName#if($foreach.hasNext), #end#end</h1>
      </header>
      #set($pager=$model.getWeblogEntriesPager())#showWeblogEntriesPager($pager)
      <nav class="pager">#showNextPrevEntriesControl($pager)</nav>
    </main>
    #includeTemplate($model.weblog "standard_footer")
  </body>
</html>
