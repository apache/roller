<!doctype html><html lang="en"><head>#includeTemplate($model.weblog "standard_head")<title>Archives / $model.weblog.name</title></head><body>#includeTemplate($model.weblog "standard_header")<main id="content" class="reading-shell"><header class="page-title"><p class="label">DATABASE / ALL ENTRIES</p><h1>Archive</h1></header><div class="calendar">#showWeblogEntryCalendarBig($model.weblog "nil")</div><section class="archive-list"><h2>LATEST_30</h2>#set($recentEntries=$model.weblog.getRecentWeblogEntries("nil",30))<ol>#foreach($recentEntry in $recentEntries)<li><a href="$recentEntry.permalink">$recentEntry.title</a></li>#end</ol></section></main>#includeTemplate($model.weblog "standard_footer")</body></html>
