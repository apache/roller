<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src *; font-src 'self'; base-uri 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'">
    <title>$model.weblog.name</title>
    #showAutodiscoveryLinks($model.weblog)
    #showAnalyticsTrackingCode($model.weblog)
    <link rel="stylesheet" media="all" href="$model.weblog.stylesheet">
    #showMetaDescription()
    <script>
      // remember the choice, then let the link's deviceType parameter switch views
      document.addEventListener("DOMContentLoaded", function () {
        document.getElementById("btnMobile").addEventListener("click", function () {
          document.cookie = "roller_user_request_type=mobile; max-age=" + 30 * 24 * 60 * 60 + "; path=/";
        });
      });
    </script>
</head>
<!-- weblog -->
<body>

<div id="id_weblog" class="content_wrapper">
  <div class="content">
    <h1 class="weblogName">$model.weblog.name</h1>

        <center>
        #showWeblogCategoryLinksList()
        </center>

        ## show next/previous paging controls
        #set($pager = $model.getWeblogEntriesPager()) 
        <div class="next-previous">
            #showNextPrevEntriesControl($pager)
        </div>

        ## show entries
        #showWeblogEntriesPager($pager)

  </div>
</div>

<div class="rightbar_wrapper">
  <div class="rightbar">
    <div class="mobile">
        <a id="btnMobile" href="?deviceType=mobile">View Mobile Weblog</a>
    </div>
    #includeTemplate($model.weblog "sidebar")
  </div>
</div>

</body>
</html>
