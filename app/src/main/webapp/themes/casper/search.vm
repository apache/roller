#set($pager = $model.getWeblogEntriesPager())
#set($classicHome = false)
#set($feedHeader = false)
<!DOCTYPE html>
<html lang="en" class="auto-color">
  <head>
    #includeTemplate($model.weblog "standard_head")
    <title>#if($utils.isNotEmpty($model.term))$model.term — #{end}Search — $model.weblog.name</title>
  </head>
  <body class="tag-template search-template is-head-left-logo">
    <div class="viewport">
      #includeTemplate($model.weblog "standard_header")

      <div class="site-content">
        <main id="site-main" class="site-main outer">
          <div class="inner posts">
            <div class="post-feed">
              <section class="post-card post-card-large">
                <div class="post-card-content">
                  <div class="post-card-content-link">
                    <header class="post-card-header">
                      <h1 class="post-card-title">#if($utils.isNotEmpty($model.term))“$model.term”#{else}Search#end</h1>
                    </header>
                    <div class="post-card-excerpt">
                      #if($utils.isEmpty($model.term))
                      Search every post on $model.weblog.name.
                      #elseif($model.hits == 1)
                      1 post found
                      #else
                      $model.hits posts found
                      #end
                    </div>
                    <form class="gh-search-form" method="get" action="$url.search" role="search">
                      <label class="gh-search-label" for="search-input">Search this site</label>
                      <input id="search-input" class="gh-search-input" name="q" type="search" value="$model.term" placeholder="Search posts" />
                      <button class="gh-search-submit" type="submit">Search</button>
                    </form>
                  </div>
                </div>
              </section>

              #if($model.hits > 0)
              #set($cardClass = "")
              #foreach($day in $pager.entries.keySet())
              #foreach($entry in $pager.entries.get($day))
              #includeTemplate($model.weblog "_card")
              #end
              #end
              #end
            </div>

            #if($model.hits > 0 && ($pager.prevLink || $pager.nextLink))
            <nav class="pagination" aria-label="Pagination">
              #if($pager.prevLink)
              <a class="newer-posts" href="$pager.prevLink"><span aria-hidden="true">&larr;</span> Previous</a>
              #end
              #if($pager.nextLink)
              <a class="older-posts" href="$pager.nextLink">Next <span aria-hidden="true">&rarr;</span></a>
              #end
            </nav>
            #end
          </div>
        </main>
      </div>

      #includeTemplate($model.weblog "standard_footer")
    </div>
  </body>
</html>
