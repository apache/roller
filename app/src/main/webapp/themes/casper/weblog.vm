#set($pager = $model.getWeblogEntriesPager())
## Date archives use the month/day pagers, the only ones with collection links.
#set($isDateArchive = false)
#if($pager.prevCollectionLink || $pager.nextCollectionLink)
  #set($isDateArchive = true)
#end
#set($isHome = !$model.weblogCategory && !$isDateArchive && !$pager.prevLink)
#set($classicHome = $isHome)
#if($model.weblogCategory)
  #set($bodyClass = "tag-template")
#elseif($isHome)
  #set($bodyClass = "home-template")
#{else}
  #set($bodyClass = "paged")
#end
<!DOCTYPE html>
<html lang="en" class="auto-color">
  <head>
    #includeTemplate($model.weblog "standard_head")
    <title>#if($model.weblogCategory)$model.weblogCategory.name — #end$model.weblog.name#if(!$model.weblogCategory && $utils.isNotEmpty($model.weblog.tagline)) — $model.weblog.tagline#end</title>
  </head>
  <body class="$bodyClass is-head-left-logo">
    <div class="viewport">
      #includeTemplate($model.weblog "standard_header")

      <div class="site-content">
        #if($model.weblogCategory)
          #set($feedHeader = true)
          #set($headerTitle = $model.weblogCategory.name)
          #set($headerDescription = $model.weblogCategory.description)
          #set($headerCount = $model.weblogCategory.retrieveWeblogEntries(true).size())
        #{else}
          #set($feedHeader = false)
        <div class="site-header-content outer">
          <div class="site-header-inner inner">
            <h1 class="site-title">$model.weblog.name</h1>
            #if($utils.isNotEmpty($model.weblog.tagline))
            <p class="site-description">$model.weblog.tagline</p>
            #end
          </div>
        </div>
        #end

        #includeTemplate($model.weblog "_feed")
      </div>

      #includeTemplate($model.weblog "standard_footer")
    </div>
  </body>
</html>
