## Casper's post.hbs article. Expects $entry.
#includeTemplate($model.weblog "_reading_time")
#set($authorName = $entry.creator.fullName)
#if($utils.isEmpty($authorName))
  #set($authorName = $entry.creator.screenName)
#end
<main id="site-main" class="site-main">
  <article class="article post no-image">

    <header class="article-header gh-canvas">

      <div class="article-tag post-card-tags">
        #if($entry.category)
        <span class="post-card-primary-tag">
          <a href="$url.category($entry.category.name)">$entry.category.name</a>
        </span>
        #end
      </div>

      <h1 class="article-title">$entry.title</h1>

      #if($utils.isNotEmpty($entry.summary))
      <p class="article-excerpt">$utils.removeHTML($entry.summary)</p>
      #end

      <div class="article-byline">
        <section class="article-byline-content">
          <ul class="author-list">
            <li class="author-list-item">
              <span class="author-avatar author-profile-image"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><g fill="none" fill-rule="evenodd"><path d="M3.513 18.998C4.749 15.504 8.082 13 12 13s7.251 2.504 8.487 5.998C18.47 21.442 15.417 23 12 23s-6.47-1.558-8.487-4.002zM12 12c2.21 0 4-2.79 4-5s-1.79-4-4-4-4 1.79-4 4 1.79 5 4 5z" fill="#FFF"/></g></svg></span>
            </li>
          </ul>

          <div class="article-byline-meta">
            <h4 class="author-name">$authorName</h4>
            <div class="byline-meta-content">
              <time class="byline-meta-date" datetime="$utils.formatDate($entry.pubTime, 'yyyy-MM-dd')">$utils.formatDate($entry.pubTime, "dd MMM yyyy")</time>
              <span class="byline-reading-time"><span class="bull">&bull;</span> $readingTime min read</span>
            </div>
          </div>
        </section>
        #if($utils.isUserAuthorizedToAuthor($entry.website))
        <a href="$url.editEntry($entry.anchor)" class="gh-button gh-button-share">Edit</a>
        #end
      </div>

    </header>

    <section class="gh-content gh-canvas">
      $entry.displayContent
    </section>

    #if($entry.tags && $entry.tags.size() > 0)
    <section class="article-tags gh-canvas" aria-label="Tags">
      <ul>
        #foreach($tag in $entry.tags)
        <li><a href="$url.tag($tag.name)">#$tag.name</a></li>
        #end
      </ul>
    </section>
    #end

    #if($entry.commentCount > 0 || $entry.commentsStillAllowed)
    <section class="article-comments gh-canvas">
      #if($entry.commentCount > 0 || $model.commentForm.preview)
      #showWeblogEntryComments($entry)
      #end
      #if($entry.commentsStillAllowed)
      #showWeblogEntryCommentForm($entry)
      #end
    </section>
    #end

  </article>
</main>

