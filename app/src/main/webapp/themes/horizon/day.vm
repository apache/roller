#foreach($entry in $entries)
<article class="post-card">
  <a id="$utils.encode($entry.anchor)"></a>
  <div class="post-meta">
    <time datetime="$utils.formatDate($entry.pubTime, 'yyyy-MM-dd')">
      $utils.formatDate($entry.pubTime, "MMM d, yyyy")
    </time>
    <span aria-hidden="true">·</span>
    <a href="$url.category($entry.category.name)">$entry.category.name</a>
  </div>
  #if($model.permalink)
  <h1 class="post-title">$entry.title</h1>
  #else
  <h2 class="post-title"><a href="$entry.permalink">$entry.title</a></h2>
  #end
  <div class="post-content">
    #if($model.permalink)$entry.displayContent#else$entry.displayContent($url.entry($entry.anchor))#end
  </div>
  <footer class="post-footer">
    #if($entry.tags && $entry.tags.size()>0)
    <div class="post-tags">
      #foreach($tag in $entry.tags)
      <a href="$url.tag($tag.name)">#$tag.name</a>
      #end
    </div>
    #end#set($commentCount=$entry.commentCount)#if($entry.commentsStillAllowed || $commentCount>0)
    <a href="$url.comments($entry.anchor)">$commentCount comments</a>
    #end#if($utils.isUserAuthorizedToAuthor($entry.website))
    <a href="$url.editEntry($entry.anchor)">Edit</a>
    #end
  </footer>
  #showTrackbackAutodiscovery($entry)
</article>
#end
