<!DOCTYPE html>
<html lang="$model.weblog.localeInstance.toLanguageTag()">
  <head>
    #includeTemplate($model.weblog "standard_head")
    #if($model.tags && $model.tags.size() > 0)
    <title>#foreach($tagName in $model.tags)$tagName#if($foreach.hasNext), #end#end &middot; $model.weblog.name</title>
    #elseif($model.weblogCategory)
    <title>$model.weblogCategory.name &middot; $model.weblog.name</title>
    #elseif($utils.isNotEmpty($model.weblog.tagline))
    <title>$model.weblog.name &middot; $model.weblog.tagline</title>
    #else
    <title>$model.weblog.name</title>
    #end
  </head>
  <body>
    #includeTemplate($model.weblog "standard_sidebar")

    <main class="content container">
      #set($pager = $model.getWeblogEntriesPager())
      #if($model.tags && $model.tags.size() > 0)
      <h1 class="page-title">Tagged #foreach($tagName in $model.tags)<em>$tagName</em>#if($foreach.hasNext), #end#end</h1>
      #elseif($model.weblogCategory)
      <h1 class="page-title">$model.weblogCategory.name</h1>
      #if($utils.isNotEmpty($model.weblogCategory.description))
      <p class="lead">$model.weblogCategory.description</p>
      #end
      #elseif(!$pager.prevLink && $utils.isNotEmpty($model.weblog.about))
      <div class="message">$model.weblog.about</div>
      #end
      #includeTemplate($model.weblog "_post_list")
    </main>
  </body>
</html>
