## Hyde's _includes/sidebar.html.
<div class="sidebar">
  <div class="container sidebar-sticky">
    <div class="sidebar-about">
      <h1>
        <a href="$url.home">$model.weblog.name</a>
      </h1>
      #if($utils.isNotEmpty($model.weblog.tagline))
      <p class="lead">$model.weblog.tagline</p>
      #end
    </div>

    <nav class="sidebar-nav" aria-label="Pages">
      <a class="sidebar-nav-item" href="$url.home">Home</a>
      #foreach($navPage in $model.weblog.templates)
      #if($navPage.navbar && !$navPage.hidden && $navPage.link)
      <a class="sidebar-nav-item#if($model.weblogPage && $model.weblogPage.id == $navPage.id) active#end" href="$url.page($navPage.link)">$navPage.name</a>
      #end
      #end
      <a class="sidebar-nav-item#if($model.searchResults) active#end" href="$url.search">Search</a>
      <a class="sidebar-nav-item" href="$url.feed.entries.atom">Atom feed</a>
      #if($utils.isUserAuthorizedToAuthor($model.weblog))
      <a class="sidebar-nav-item" href="$url.createEntry">New entry</a>
      #end
    </nav>

    <p>&copy; $utils.formatDate($utils.now, "yyyy"). Powered by <a href="https://roller.apache.org/" rel="noopener">Apache Roller</a> and <a href="https://github.com/poole/hyde" rel="noopener">Hyde</a>.</p>
  </div>
</div>
