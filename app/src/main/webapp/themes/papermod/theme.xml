<weblogtheme>
  <id>papermod</id><name>PaperMod</name>
  <description>A port of the PaperMod theme for Hugo: a fast, clean, card-based layout with reading times and automatic light and dark modes.</description>
  <author>Aditya Telange (ported for Apache Roller)</author>
  <preview-image path="preview.png" />
  <stylesheet><name>custom.css</name><description>PaperMod custom styles</description><link>custom.css</link><contentType>text/css</contentType><rendition><contentsFile>custom.css</contentsFile><templateLanguage>velocity</templateLanguage></rendition></stylesheet>
  <template action="weblog"><name>Weblog</name><description>Home, category, and date archive lists</description><navbar>false</navbar><hidden>true</hidden><contentType>text/html</contentType><rendition><contentsFile>weblog.vm</contentsFile><templateLanguage>velocity</templateLanguage></rendition></template>
  <template action="permalink"><name>Entry</name><description>Single entry</description><navbar>false</navbar><hidden>true</hidden><contentType>text/html</contentType><rendition><contentsFile>entry.vm</contentsFile><templateLanguage>velocity</templateLanguage></rendition></template>
  <template action="search"><name>Search</name><description>Search page and results</description><navbar>false</navbar><hidden>true</hidden><contentType>text/html</contentType><rendition><contentsFile>search.vm</contentsFile><templateLanguage>velocity</templateLanguage></rendition></template>
  <template action="tagsIndex"><name>TagsIndex</name><description>Tagged entries</description><navbar>false</navbar><hidden>true</hidden><contentType>text/html</contentType><rendition><contentsFile>tags.vm</contentsFile><templateLanguage>velocity</templateLanguage></rendition></template>
  <template action="custom"><name>Archives</name><description>Entries grouped by year and month</description><link>archives</link><navbar>true</navbar><hidden>false</hidden><contentType>text/html</contentType><rendition><contentsFile>archives.vm</contentsFile><templateLanguage>velocity</templateLanguage></rendition></template>
  <template action="custom"><name>Tags</name><description>All tags with entry counts</description><link>tags</link><navbar>true</navbar><hidden>false</hidden><contentType>text/html</contentType><rendition><contentsFile>terms.vm</contentsFile><templateLanguage>velocity</templateLanguage></rendition></template>
  <template action="custom"><name>standard_head</name><description>HTML head</description><navbar>false</navbar><hidden>true</hidden><contentType>text/html</contentType><rendition><contentsFile>head.vm</contentsFile><templateLanguage>velocity</templateLanguage></rendition></template>
  <template action="custom"><name>standard_header</name><description>Site header</description><navbar>false</navbar><hidden>true</hidden><contentType>text/html</contentType><rendition><contentsFile>header.vm</contentsFile><templateLanguage>velocity</templateLanguage></rendition></template>
  <template action="custom"><name>standard_footer</name><description>Site footer</description><navbar>false</navbar><hidden>true</hidden><contentType>text/html</contentType><rendition><contentsFile>footer.vm</contentsFile><templateLanguage>velocity</templateLanguage></rendition></template>
  <template action="custom"><name>_post_list</name><description>Entry cards and pagination</description><navbar>false</navbar><hidden>true</hidden><contentType>text/html</contentType><rendition><contentsFile>post-list.vm</contentsFile><templateLanguage>velocity</templateLanguage></rendition></template>
  <template action="custom"><name>_post_meta</name><description>Date, reading time, and author line</description><navbar>false</navbar><hidden>true</hidden><contentType>text/html</contentType><rendition><contentsFile>post-meta.vm</contentsFile><templateLanguage>velocity</templateLanguage></rendition></template>
  <resource path="theme.css" /><resource path="theme.js" /><resource path="preview.png" />
</weblogtheme>
