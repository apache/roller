<!doctype html>
<html lang="en" data-theme="auto">
  <head>
    #includeTemplate($model.weblog "standard_head")
    <title>$model.weblogEntry.title | $model.weblog.name</title>
  </head>
  <body id="top">
    #includeTemplate($model.weblog "standard_header")
    <main class="main">
      #set($entry = $model.weblogEntry)
      <article class="post-single">
        <header class="post-header">
          <h1 class="post-title entry-hint-parent">$entry.title</h1>
          <div class="post-meta">
            #set($metaShowCategory = true)
            #includeTemplate($model.weblog "_post_meta")
            #if($utils.isUserAuthorizedToAuthor($entry.website))
            <span class="entry-edit"><a href="$url.editEntry($entry.anchor)" rel="edit">Edit</a></span>
            #end
          </div>
        </header>
        <div class="post-content md-content">
          $entry.displayContent
        </div>
        <footer class="post-footer">
          #if($entry.tags && $entry.tags.size() > 0)
          <ul class="post-tags">
            #foreach($tag in $entry.tags)
            <li><a href="$url.tag($tag.name)">$tag.name</a></li>
            #end
          </ul>
          #end
          ## PaperMod's "« Prev" is the newer entry and "Next »" the older one.
          #set($pager = $model.getWeblogEntriesPager())
          #if($pager.nextLink || $pager.prevLink)
          #set($newerEntry = false)
          #set($olderEntry = false)
          #set($recentEntries = $model.weblog.getRecentWeblogEntries("nil", 100))
          #foreach($recentEntry in $recentEntries)
          #if($recentEntry.anchor == $entry.anchor)
          #if($foreach.index > 0)
          #set($newerEntry = $recentEntries.get($foreach.index - 1))
          #end
          #if($foreach.hasNext)
          #set($olderEntry = $recentEntries.get($foreach.index + 1))
          #end
          #end
          #end
          <nav class="paginav">
            #if($pager.nextLink)
            <a class="prev" href="$pager.nextLink">
              <span class="title">« Prev</span>
              <span>#if($newerEntry)$newerEntry.title#{else}$pager.nextName#end</span>
            </a>
            #end
            #if($pager.prevLink)
            <a class="next" href="$pager.prevLink">
              <span class="title">Next »</span>
              <span>#if($olderEntry)$olderEntry.title#{else}$pager.prevName#end</span>
            </a>
            #end
          </nav>
          #end
        </footer>
        #set($hasComments = $entry.commentCount > 0 || $model.commentForm.preview)
        #if($hasComments || $entry.commentsStillAllowed)
        <div class="post-comments">
          #if($hasComments)
          #showWeblogEntryComments($entry)
          #end
          #if($entry.commentsStillAllowed)
          #showWeblogEntryCommentForm($entry)
          #end
        </div>
        #end
      </article>
    </main>
    #includeTemplate($model.weblog "standard_footer")
  </body>
</html>
