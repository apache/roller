<header class="header">
  <nav class="header-nav">
    <div class="logo">
      <a href="$url.home" accesskey="h" title="$model.weblog.name (Alt + H)">$model.weblog.name</a>
      <div class="logo-switches">
        <button id="theme-toggle" class="theme-toggle" accesskey="t" title="(Alt + T)" aria-label="Toggle theme">
          <svg class="moon" xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <svg class="sun" xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
        </button>
      </div>
    </div>
    <ul id="menu" class="menu">
      ## Archives and Tags ship with this theme; other navbar pages come from
      ## the weblog (listed by link so previews of this theme still show both).
      #set($themePages = {"archives": "Archives", "tags": "Tags"})
      #foreach($pageLink in $themePages.keySet())
      #set($pageTitle = $themePages.get($pageLink))
      <li>
        <a href="$url.page($pageLink)" title="$pageTitle">
          <span#if($model.weblogPage && $model.weblogPage.link == $pageLink) class="active"#end>$pageTitle</span>
        </a>
      </li>
      #end
      #foreach($iPage in $model.weblog.pages)
      #if(!$iPage.hidden && $iPage.navbar && $iPage.link != "Weblog" && !$themePages.containsKey($iPage.link))
      <li>
        <a href="$url.page($iPage.link)" title="$iPage.name">
          <span#if($model.weblogPage && $iPage.id == $model.weblogPage.id) class="active"#end>$iPage.name</span>
        </a>
      </li>
      #end
      #end
      <li>
        <a href="$url.search" title="Search (Alt + /)" accesskey="/">
          <span#if($model.searchResults) class="active"#end>Search</span>
        </a>
      </li>
    </ul>
  </nav>
</header>
