{
  "id": "roller",
  "realm": "roller",
  "displayName": "Apache Roller",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "id": "a1b2c3d4-0001-0001-0001-000000000001",
        "name": "admin",
        "description": "Roller administrator role",
        "composite": false,
        "clientRole": false,
        "containerId": "roller",
        "attributes": {}
      },
      {
        "id": "a1b2c3d4-0001-0001-0001-000000000002",
        "name": "editor",
        "description": "Roller editor role",
        "composite": false,
        "clientRole": false,
        "containerId": "roller",
        "attributes": {}
      },
      {
        "id": "a1b2c3d4-0001-0001-0001-000000000003",
        "name": "offline_access",
        "description": "${role_offline-access}",
        "composite": false,
        "clientRole": false,
        "containerId": "roller",
        "attributes": {}
      },
      {
        "id": "a1b2c3d4-0001-0001-0001-000000000004",
        "name": "uma_authorization",
        "description": "${role_uma_authorization}",
        "composite": false,
        "clientRole": false,
        "containerId": "roller",
        "attributes": {}
      },
      {
        "id": "a1b2c3d4-0001-0001-0001-000000000005",
        "name": "default-roles-roller",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization"
          ],
          "client": {
            "account": [
              "view-profile",
              "manage-account"
            ]
          }
        },
        "clientRole": false,
        "containerId": "roller",
        "attributes": {}
      }
    ]
  },
  "groups": [
    {
      "id": "a1b2c3d4-0002-0001-0001-000000000001",
      "name": "Admins",
      "path": "/Admins",
      "realmRoles": [
        "admin"
      ],
      "subGroups": []
    },
    {
      "id": "a1b2c3d4-0002-0001-0001-000000000002",
      "name": "Editors",
      "path": "/Editors",
      "realmRoles": [
        "editor"
      ],
      "subGroups": []
    }
  ],
  "defaultGroups": [
    "/Editors"
  ],
  "clients": [
    {
      "id": "a1b2c3d4-0003-0001-0001-000000000001",
      "clientId": "web_app",
      "surrogateAuthRequired": false,
      "enabled": true,
      "alwaysDisplayInConsole": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "web_app",
      "redirectUris": [
        "http://localhost:8080/*",
        "http://127.0.0.1:8080/*"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://127.0.0.1:8080"
      ],
      "notBefore": 0,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "publicClient": false,
      "frontchannelLogout": false,
      "protocol": "openid-connect",
      "attributes": {
        "post.logout.redirect.uris": "+"
      },
      "fullScopeAllowed": true,
      "nodeReRegistrationTimeout": -1,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roller",
        "roles",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access"
      ]
    }
  ],
  "clientScopes": [
    {
      "id": "a1b2c3d4-0004-0001-0001-000000000001",
      "name": "roller",
      "description": "Roller-specific claims",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "id": "a1b2c3d4-0005-0001-0001-000000000001",
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "id": "a1b2c3d4-0004-0001-0001-000000000010",
      "name": "acr",
      "description": "OpenID Connect scope for add acr (authentication context class reference) to the token",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "id": "a1b2c3d4-0005-0001-0001-000000000010",
          "name": "acr loa level",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-acr-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "id": "a1b2c3d4-0004-0001-0001-000000000011",
      "name": "roles",
      "description": "OpenID Connect scope for add user realm and client roles to the token",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "true",
        "consent.screen.text": "${rolesScopeConsentText}"
      },
      "protocolMappers": [
        {
          "id": "a1b2c3d4-0005-0001-0001-000000000011",
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "user.attribute": "foo",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        },
        {
          "id": "a1b2c3d4-0005-0001-0001-000000000012",
          "name": "audience resolve",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-resolve-mapper",
          "consentRequired": false,
          "config": {}
        },
        {
          "id": "a1b2c3d4-0005-0001-0001-000000000013",
          "name": "client roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "user.attribute": "foo",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "resource_access.${client_id}.roles",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "id": "a1b2c3d4-0004-0001-0001-000000000012",
      "name": "web-origins",
      "description": "OpenID Connect scope for add allowed web origins to the token",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false",
        "consent.screen.text": ""
      },
      "protocolMappers": [
        {
          "id": "a1b2c3d4-0005-0001-0001-000000000014",
          "name": "allowed web origins",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-allowed-origins-mapper",
          "consentRequired": false,
          "config": {}
        }
      ]
    },
    {
      "id": "a1b2c3d4-0004-0001-0001-000000000002",
      "name": "email",
      "description": "OpenID Connect built-in scope: email",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "${emailScopeConsentText}"
